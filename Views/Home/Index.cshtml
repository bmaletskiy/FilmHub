@model IEnumerable<FilmHub.Models.Movie>

@{
    ViewData["Title"] = "FilmHub";
}

<style>
    .hero {
        background: linear-gradient(135deg, #111827, #1f2937);
        color: white;
        border-radius: 1rem;
        padding: 4rem 2rem;
        margin-bottom: 3rem;
    }

    .movie-card {
        transition: transform .2s ease, box-shadow .2s ease;
        border: 0;
        overflow: hidden;
    }

    .movie-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.15);
    }

    .movie-poster {
        aspect-ratio: 2 / 3;
        object-fit: cover;
        width: 100%;
    }

    .poster-placeholder {
        aspect-ratio: 2 / 3;
        background: #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
    }

    .movie-description {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="container py-4">

    <!-- Hero -->
    <section class="hero text-center">
        <h1 class="display-3 fw-bold mb-3">FilmHub</h1>

        <p class="lead mb-4">
            Discover movies, explore genres and read community reviews.
        </p>

        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a asp-controller="Movies"
               asp-action="Index"
               class="btn btn-primary btn-lg">
                Browse Movies
            </a>

            <a asp-controller="Movies"
               asp-action="Create"
               class="btn btn-outline-light btn-lg">
                Add Movie
            </a>
        </div>
    </section>

    <!-- Movies -->
    <section>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Latest Movies</h2>
                <p class="text-muted mb-0">
                    Explore movies available on FilmHub
                </p>
            </div>

            <a asp-controller="Movies"
               asp-action="Index"
               class="btn btn-outline-primary">
                View All
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No movies have been added yet.
            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var movie in Model)
                {
                    var avgRating = movie.Reviews.Any()
                        ? movie.Reviews.Average(r => r.Rating)
                        : 0;

                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card movie-card h-100 shadow-sm">

                            @if (!string.IsNullOrEmpty(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl"
                                     alt="@movie.Title poster"
                                     class="movie-poster" />
                            }
                            else
                            {
                                <div class="poster-placeholder">
                                    No poster
                                </div>
                            }

                            <div class="card-body d-flex flex-column">

                                <h5 class="card-title fw-bold">
                                    @movie.Title
                                </h5>

                                <p class="text-muted mb-2">
                                    @movie.ReleaseYear
                                </p>

                                <div class="mb-2">
                                    @foreach (var genre in movie.Genres.Take(3))
                                    {
                                        <span class="badge text-bg-secondary me-1 mb-1">
                                            @genre.Name
                                        </span>
                                    }
                                </div>

                                @if (movie.Reviews.Any())
                                {
                                    <div class="mb-2">
                                        <span class="badge text-bg-warning">
                                            ★ @avgRating.ToString("0.0") / 10
                                        </span>

                                        <small class="text-muted ms-1">
                                            (@movie.Reviews.Count)
                                        </small>
                                    </div>
                                }

                                <p class="card-text movie-description">
                                    @movie.Description
                                </p>

                                <div class="mt-auto">
                                    <a asp-controller="Movies"
                                       asp-action="Details"
                                       asp-route-id="@movie.Id"
                                       class="btn btn-primary w-100">
                                        View Details
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>
                }

            </div>
        }
    </section>

</div>