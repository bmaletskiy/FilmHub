@model FilmHub.Models.Movie

@{
    ViewData["Title"] = "Add Movie";
}

<h1>Add Movie</h1>
<h4>Movie</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description"
                       class="form-label"></label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReleaseYear"
                       class="form-label"></label>
                <input asp-for="ReleaseYear"
                       class="form-control" />
                <span asp-validation-for="ReleaseYear"
                      class="text-danger"></span>
            </div>

            
            <div class="mb-3">
                <label for="posterFile" class="form-label">Poster</label>

                <div id="posterDropZone"
                     class="border border-2 border-dashed rounded p-4 text-center mb-3">
                    <p>Drag and drop a poster here</p>
                    <p class="text-muted">or select an image</p>

                    <input type="file"
                           id="posterFile"
                           name="posterFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />
                </div>

                <img id="posterPreview"
                     class="img-fluid rounded mb-2"
                     style="max-height: 300px;"
                     alt="Poster preview"
                     hidden />

                <div id="posterInfo" class="text-muted small mb-2"></div>
                <div id="posterError" class="text-danger mb-2"></div>

                <button type="button"
                        id="removePoster"
                        class="btn btn-outline-danger btn-sm"
                        hidden>
                    Remove Poster
                </button>
            </div>


            <div class="mb-3">
                <label class="form-label" for="selectedGenreIds">Genres</label>
                <select id="selectedGenreIds" name="selectedGenreIds"
                        class="form-control js-genre-select" multiple
                        data-search-url="@Url.Action("Search", "Genres")"
                        aria-describedby="genre-help">
                    @foreach (var genre in (List<FilmHub.Models.Genre>)ViewBag.SelectedGenres)
                    {
                        <option value="@genre.Id" selected>@genre.Name</option>
                    }
                </select>
                <div id="genre-help" class="form-text">Введіть щонайменше 3 символи для пошуку жанрів.</div>
                @if (ViewData.ModelState.TryGetValue("selectedGenreIds", out var genreState))
                {
                    @foreach (var error in genreState.Errors)
                    {
                        <span class="text-danger d-block">
                            @error.ErrorMessage
                        </span>
                    }
                }
            </div>

            <button type="submit" class="btn btn-primary">
                Create
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to List
            </a>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_GenreSelectScriptsPartial" />

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/poster-upload.js"
            asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
}

