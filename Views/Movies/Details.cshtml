@model FilmHub.Models.Movie

@{
    ViewData["Title"] = Model.Title;
    var avg = Model.Reviews.Any() ? Model.Reviews.Average(r => r.Rating) : 0;
}

<style>
    html {
        scroll-behavior: smooth;
    }

    body {
        padding-bottom: 70px;
    }

    section {
        scroll-margin-top: 70px;
    }

    .poster-placeholder {
        aspect-ratio: 2 / 3;
        background: #e9ecef;
        border-radius: .5rem;
    }
</style>

<!-- Sticky section menu -->
<nav class="navbar bg-body-tertiary sticky-top border-bottom mb-4">
    <div class="container-fluid">
        <span class="navbar-brand mb-0 h6">@Model.Title</span>
        <div class="d-flex gap-3">
            <a class="nav-link" href="#top">Overview</a>
            <a class="nav-link" href="#about">About</a>
            <a class="nav-link" href="#reviews">Reviews</a>
        </div>
    </div>
</nav>

<!-- Hero -->
<section id="top" class="py-3">
    <div class="row align-items-center g-4">
        <div class="col-md-4 text-center">
            @if (!string.IsNullOrEmpty(Model.PosterUrl))
            {
                <img src="@Model.PosterUrl"
                     alt="Poster of @Model.Title"
                     class="img-fluid rounded shadow" />
            }
            else
            {
                <div class="poster-placeholder d-flex align-items-center justify-content-center text-muted">
                    No poster
                </div>
            }
        </div>

        <div class="col-md-8">
            <h1 class="display-5 fw-bold">@Model.Title</h1>
            <p class="fs-5 text-muted">@Model.ReleaseYear</p>

            <div class="mb-3">
                @foreach (var genre in Model.Genres.OrderBy(g => g.Name))
                {
                    <span class="badge text-bg-primary me-1">@genre.Name</span>
                }
            </div>

            @if (Model.Reviews.Any())
            {
                <p class="fs-3 mb-4">
                    ★ @avg.ToString("0.0") <small class="text-muted fs-6">/ 10 · @Model.Reviews.Count reviews</small>
                </p>
            }

            <a href="#reviews" class="btn btn-primary btn-lg">Read reviews</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Back to catalog</a>
        </div>
    </div>
</section>

<!-- About -->
<section id="about" class="py-5">
    <h2 class="mb-3">About the movie</h2>
    <div class="card shadow-sm">
        <div class="card-body fs-5">
            @Model.Description
        </div>
    </div>
</section>

<!-- Reviews -->
<section id="reviews" class="py-5">
    <h2 class="mb-3">Reviews</h2>

    @if (!Model.Reviews.Any())
    {
        <p class="text-muted">No reviews yet.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var review in Model.Reviews.OrderByDescending(r => r.Id))
            {
                var cls = review.Rating >= 7 ? "text-bg-success"
                        : review.Rating >= 5 ? "text-bg-warning"
                        : "text-bg-danger";

                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title mb-0">@review.Author</h5>
                                <span class="badge @cls">@review.Rating / 10</span>
                            </div>
                            <p class="card-text">@review.Text</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <form asp-controller="Reviews"
      asp-action="Create"
      method="post"
      class="mt-4">

    <input type="hidden"
           name="MovieId"
           value="@Model.Id" />

    <input type="text"
       name="Author" 
       class="form-control"
       required
       placeholder="Enter username"/>

    <textarea name="Text"
          class="form-control"
          required
          placeholder="Enter your comment">
    </textarea>

    <button type="submit">
    Send
    </button>

</form>

    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-link">Edit movie</a>
    </div>
</section>

<!-- Contacts: always visible -->
<div id="contact" class="fixed-bottom bg-dark text-white py-2 shadow">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="fw-semibold">Questions about “@Model.Title”?</span>
        <div class="d-flex gap-3">
            <a class="link-light" href="mailto:contact@filmhub.example">contact@filmhub.example</a>
            <a class="link-light" href="tel:+380000000000">+38 000 000 00 00</a>
            <a class="link-light" href="https://t.me/your_username">Telegram</a>
        </div>
    </div>
</div>