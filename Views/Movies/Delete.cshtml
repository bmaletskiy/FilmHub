@model FilmHub.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h1>Delete Movie</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this movie?
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-4">

            <div class="col-md-3">
                @if (!string.IsNullOrEmpty(Model.PosterUrl))
                {
                    <img src="@Model.PosterUrl"
                         alt="@Model.Title poster"
                         class="img-fluid rounded"
                         style="max-height: 300px;" />
                }
                else
                {
                    <div class="text-muted">No poster available</div>
                }
            </div>

            <div class="col-md-9">
                <h3>@Model.Title</h3>

                <p>
                    <strong>Release Year:</strong>
                    @Model.ReleaseYear
                </p>

                <p>
                    <strong>Description:</strong>
                    @Model.Description
                </p>

                <div class="mb-3">
                    <strong>Genres:</strong>

                    @if (Model.Genres.Any())
                    {
                        @foreach (var genre in Model.Genres.OrderBy(g => g.Name))
                        {
                            <span class="badge bg-secondary me-1">
                                @genre.Name
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">No genres</span>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
