
@{
    ViewData["Title"] = "Movie Catcher";
}

<div class="container py-4">
    <div class="text-center mb-4">
        <h1>🎬 Movie Catcher</h1>
        <p class="text-muted">
            Catch movie tickets and earn points!
        </p>
    </div>

    <div class="mx-auto" style="max-width: 800px;">
        <div class="d-flex justify-content-between mb-3">
            <span>Score: <strong id="gameScore">0</strong></span>
            <span>Lives: <strong id="gameLives">3</strong></span>
            <span>Best: <strong id="gameBest">0</strong></span>
        </div>

        <canvas id="gameCanvas"
                width="800"
                height="450"
                class="w-100 rounded border"
                style="background: #0f172a;">
        </canvas>

        <div class="d-flex justify-content-center gap-2 mt-3">
            <button id="startGame" class="btn btn-primary">
                Start Game
            </button>

            <button id="pauseGame" class="btn btn-warning" disabled>
                Pause
            </button>

            <button id="restartGame" class="btn btn-secondary">
                Restart
            </button>
        </div>

        <p class="text-center text-muted mt-3">
            Move: ← → or A / D | Pause: P
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/js/movie-catcher.js"
            asp-append-version="true"></script>
}
